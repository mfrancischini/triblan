---
import CtaButton from "./CtaButton.astro"
---

<footer class="relative overflow-hidden">
  <section class="max-w-4xl mx-auto px-8 py-8 border-t border-line">
    <div class="flex flex-col gap-6 text-sm">
      <p class="font-serif text-xs text-muted tracking-wider text-center sm:text-left">
        © 2026 Triblan Estudio Jurídico • Olivos, Zona Norte • estudiotriblan@gmail.com
      </p>

      <div class="flex flex-col gap-4 items-center justify-center sm:flex-row sm:items-center sm:justify-between">
        <div class="flex flex-wrap items-center justify-center gap-3">
        
          <CtaButton variant="text" href="/#home" className="min-w-[8rem] justify-center">
            ↑ Volver arriba
          </CtaButton>
        </div>

        <a
          href="https://mfrancischini.github.io/miporfolio/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex max-w-full items-center justify-center gap-2 rounded-full border border-line2 bg-surface2/90 px-3 py-2 text-xs font-medium text-ink transition hover:border-ink hover:text-ink sm:justify-start"
          aria-label="Ver el portafolio del desarrollador M. Francischini"
        >
          <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-amber-100 text-amber-700">
            <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 7.75a2.25 2.25 0 1 0 0 4.5 2.25 2.25 0 0 0 0-4.5Zm0-2.25a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9Zm7.94 4.25a.75.75 0 0 0-.45-.7l-1.72-.68a6.49 6.49 0 0 0-.63-1.14l.9-1.6a.75.75 0 0 0-.16-.95l-1.06-1.06a.75.75 0 0 0-.95-.16l-1.6.9a6.49 6.49 0 0 0-1.14-.63l-.68-1.72a.75.75 0 0 0-.7-.45H9.25a.75.75 0 0 0-.7.45l-.68 1.72a6.49 6.49 0 0 0-1.14.63l-1.6-.9a.75.75 0 0 0-.95.16L2.2 6.82a.75.75 0 0 0-.16.95l.9 1.6c-.24.37-.43.77-.63 1.14l-1.72.68a.75.75 0 0 0-.45.7v2.12c0 .31.18.6.45.7l1.72.68c.2.37.39.77.63 1.14l-.9 1.6a.75.75 0 0 0 .16.95l1.06 1.06c.35.35.9.18.95-.16l.9-1.6c.37.24.77.43 1.14.63l.68 1.72c.1.27.39.45.7.45h2.12c.31 0 .6-.18.7-.45l.68-1.72c.37-.2.77-.39 1.14-.63l1.6.9c.35.2.8.02.95-.16l1.06-1.06a.75.75 0 0 0 .16-.95l-.9-1.6c.24-.37.43-.77.63-1.14l1.72-.68c.27-.1.45-.39.45-.7V9.5ZM12 18a6 6 0 1 1 0-12 6 6 0 0 1 0 12Z" fill="currentColor"/>
            </svg>
          </span>
          <span>Desarrollado por M. Francischini</span>
        </a>
      </div>
    </div>
  </section>
</footer>
