---
import { twMerge } from "tailwind-merge";

interface props {
  className?: string;
}

const { className } = Astro.props;
---

<span
  class={twMerge(
    "relative flex items-center justify-center h-2.5 w-2.5",
    className,
  )}
  aria-hidden="true"
>
  <span
    class="animate-ping absolute inline-flex h-full w-full rounded-full bg-lime opacity-75"
  ></span>
  <span class="relative inline-flex rounded-full h-2 w-2 bg-lime"></span>
</span>
